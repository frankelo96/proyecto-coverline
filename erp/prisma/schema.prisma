// =============================================================================
// Coverline Uniformes — ERP / CRM / Producción / POS
// PostgreSQL + Prisma ORM 7 (driver adapter @prisma/adapter-pg)
//
// Convenciones:
//   - Montos de dinero:        Decimal(14, 2)
//   - Costos unitarios:        Decimal(14, 4)  (telas por metro/kg, avíos por unidad)
//   - Cantidades / consumos:   Decimal(12, 4)  (permite venta fraccionada y m/kg)
//   - Porcentajes:             Decimal(6, 2)
//   - Tablas en snake_case vía @@map, columnas en camelCase.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum ClientType {
  PARTICULAR
  ESCUELA
  EMPRESA
  CLINICA
  GASTRONOMICO
  OTRO
}

enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

enum DocumentType {
  CUIT
  CUIL
  DNI
  PASAPORTE
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  PRESUPUESTADO
  NEGOCIACION
  GANADO
  PERDIDO
}

enum QuoteStatus {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  VENCIDO
}

enum RawMaterialType {
  TELA
  AVIO
  EMPAQUE
  INSUMO
}

enum UnitOfMeasure {
  METRO
  KILOGRAMO
  UNIDAD
  PAR
  CONO
  ROLLO
}

enum ProductCategory {
  TRABAJO
  ESCOLAR
  MEDICA
  GASTRONOMICA
  ACCESORIO
}

enum PricingMode {
  MARKUP // precio = costo * (1 + markup%)
  MARGIN // precio = costo / (1 - margen%)
}

enum ServiceType {
  CORTE
  CONFECCION
  BORDADO
  ESTAMPADO
  SUBLIMACION
  PLANCHADO
  EMPAQUE
  FLETE
  OTRO
}

enum WorkshopType {
  CONFECCION
  BORDADO
  ESTAMPADO
  SUBLIMACION
  PLANCHADO
}

enum ProductionStage {
  CORTE_INTERNO
  EN_TALLER_CONFECCION
  EN_PERSONALIZACION
  CONTROL_CALIDAD_PLANCHADO
  LISTO_ENTREGA
}

enum ProductionOrderStatus {
  BORRADOR
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum WorkshopRemitType {
  ENVIO
  RECEPCION
}

enum SaleChannel {
  MOSTRADOR
  WHATSAPP
  WEB
  MAYORISTA
}

enum SaleStatus {
  PRESUPUESTO
  PENDIENTE
  CONFIRMADA
  ENTREGADA
  ANULADA
}

enum DeliveryMethod {
  RETIRO_SUCURSAL
  ENVIO
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
  NOTA_CREDITO_C
  TICKET_INTERNO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  MERCADO_PAGO
  MODO
  TRANSFERENCIA
  CUENTA_CORRIENTE
  /// Cheque físico (de terceros o propio según Cheque.kind)
  CHEQUE
  ECHEQ
  /// Solo para imputaciones de una orden de pago con varios instrumentos
  MIXTO
}

enum CashRegisterKind {
  CAJA_DIARIA
  CAJA_ADMINISTRATIVA
  /// Caja negra / resguardo: recibe retiros de las cajas diarias y paga en efectivo
  CAJA_RESGUARDO
  BILLETERA_VIRTUAL
  BANCO
}

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  APERTURA
  INGRESO
  EGRESO
  AJUSTE
  AJUSTE_SOBRANTE
  AJUSTE_FALTANTE
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
}

enum SaleKind {
  VENTA
  /// Devolución: nota de crédito (A/B) o devolución interna sobre un ticket
  DEVOLUCION
}

/// Estado del comprobante frente a ARCA (facturación electrónica WSFEv1).
enum ArcaStatus {
  NO_APLICA
  PENDIENTE
  AUTORIZADO
  RECHAZADO
}

enum ChequeKind {
  TERCERO
  PROPIO
}

enum ChequeFormat {
  FISICO
  ECHEQ
}

enum ChequeStatus {
  /// De terceros
  EN_CARTERA
  DEPOSITADO
  COBRADO
  ENDOSADO
  /// Propios
  EMITIDO
  DEBITADO
  /// Ambos
  RECHAZADO
  ANULADO
}

enum AccountStatus {
  PENDIENTE
  PARCIAL
  CANCELADO
  ANULADO
}

enum PurchaseStatus {
  BORRADOR
  RECIBIDA
  ANULADA
}

/// Separa la compra de bienes (stock) de la factura de servicios de talleres.
enum PurchaseKind {
  MERCADERIA
  SERVICIO_TALLER
}

enum PurchaseItemType {
  MATERIA_PRIMA
  AVIO_INSUMO
  PRODUCTO_TERMINADO
  SERVICIO_CONFECCION
  SERVICIO_PERSONALIZACION
}

enum ProductSourcing {
  FABRICADO
  REVENTA
}

enum CostSnapshotReason {
  MANUAL
  CAMBIO_PRECIO_MATERIAL
  CAMBIO_TARIFA_SERVICIO
  CAMBIO_FICHA_TECNICA
  COMPRA
}

// -----------------------------------------------------------------------------
// SEGURIDAD Y AUDITORÍA
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Permisos con formato "modulo:accion" (ej. "pos:discount", "production:cost:write")
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  active             Boolean   @default(true)
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  lastLoginAt        DateTime?
  /// Intentos fallidos consecutivos; al superar el límite se bloquea temporalmente
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  /// Debe cambiar la contraseña al ingresar (clave inicial o reseteada)
  mustChangePassword Boolean   @default(false)
  /// Local en el que trabaja: si está cargado, solo opera las cajas de ese local
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  authSessions         Session[]
  chequesCreated       Cheque[]
  receipts             Receipt[]
  purchasesCreated     Purchase[]
  paymentOrders        PaymentOrder[]
  remitsCreated        WorkshopRemit[]
  productionOrders     ProductionOrder[]
  ownedLeads           Lead[]
  quotes               Quote[]
  sales                Sale[]
  paymentsCreated      Payment[]
  cashMovements        CashMovement[]
  sessionsOpened       CashRegisterSession[]     @relation("SessionOpenedBy")
  sessionsClosed       CashRegisterSession[]     @relation("SessionClosedBy")
  productionStageLogs  ProductionStageLog[]
  costSnapshots        ProductCostSnapshot[]
  materialPriceChanges RawMaterialPriceHistory[]
  auditLogs            AuditLog[]

  @@map("users")
}

/// Ticket de acceso WSAA de ARCA (válido ~12 h), cacheado por servicio.
model ArcaToken {
  id        String   @id @default(cuid())
  service   String   @unique
  token     String
  sign      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("arca_tokens")
}

/// Sesión de login. La cookie guarda un token aleatorio; en la base solo se guarda su SHA-256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String
  action    String
  /// Motivo obligatorio para acciones sensibles (descuentos, anulaciones, ajustes de caja)
  reason    String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// CRM
// -----------------------------------------------------------------------------

model Client {
  id              String       @id @default(cuid())
  type            ClientType
  businessName    String
  fantasyName     String?
  documentType    DocumentType @default(DNI)
  documentNumber  String?
  taxCondition    TaxCondition @default(CONSUMIDOR_FINAL)
  email           String?
  phone           String?
  whatsapp        String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  /// Límite para ventas en cuenta corriente / fiado. 0 = sin crédito.
  creditLimit     Decimal      @default(0) @db.Decimal(14, 2)
  paymentTermDays Int          @default(0)
  /// Segmentación de marketing (ej. "reposicion-anual", "colegio-nivel-inicial")
  tags            String[]
  /// Mes(es) del año en que el cliente suele comprar (1-12) para campañas
  purchaseMonths  Int[]
  notes           String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  designs          ClientDesign[]
  leads            Lead[]
  quotes           Quote[]
  sales            Sale[]
  productionOrders ProductionOrder[]
  receivables      AccountReceivable[]
  cheques          Cheque[]
  receipts         Receipt[]

  @@unique([documentType, documentNumber])
  @@index([type])
  @@index([businessName])
  @@map("clients")
}

/// Activos de personalización del cliente: logos, matrices de bordado, colores y curvas de talles.
model ClientDesign {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  vectorLogoUrl       String?
  embroideryFileUrl   String?
  stitchCount         Int?
  institutionalColors String[]
  /// Ej. {"S": 10, "M": 25, "L": 20, "XL": 5}
  sizeCurve           Json?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  productionOrders ProductionOrder[]

  @@index([clientId])
  @@map("client_designs")
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NUEVO)
  estimatedValue Decimal?   @db.Decimal(14, 2)
  expectedClose  DateTime?
  notes          String?
  lostReason     String?
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  quotes Quote[]

  @@index([status])
  @@map("leads")
}

model Quote {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  status        QuoteStatus @default(BORRADOR)
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  validUntil    DateTime
  subtotal      Decimal     @db.Decimal(14, 2)
  taxTotal      Decimal     @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)
  notes         String?
  /// Condiciones comerciales impresas en el presupuesto
  paymentTerms  String?
  deliveryTerms String?
  sentAt        DateTime?
  /// Fecha en que pasó a ACEPTADO o RECHAZADO
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items QuoteItem[]

  @@index([status])
  @@index([clientId])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(14, 2)
  vatRate     Decimal  @default(21) @db.Decimal(6, 2)
  discountPct Decimal  @default(0) @db.Decimal(6, 2)
  /// Neto de la línea (cantidad × precio − bonificación), sin IVA
  subtotal    Decimal  @db.Decimal(14, 2)
  sortOrder   Int      @default(0)

  @@index([quoteId])
  @@map("quote_items")
}

// -----------------------------------------------------------------------------
// ABASTECIMIENTO
// -----------------------------------------------------------------------------

model Supplier {
  id              String       @id @default(cuid())
  businessName    String
  cuit            String?      @unique
  taxCondition    TaxCondition @default(RESPONSABLE_INSCRIPTO)
  email           String?
  phone           String?
  address         String?
  paymentTermDays Int          @default(30)
  notes           String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  rawMaterials  RawMaterial[]
  purchases     Purchase[]
  payables      AccountPayable[]
  paymentOrders PaymentOrder[]

  @@map("suppliers")
}

/// Telas (por metro o kg) y avíos (botones, cierres, elásticos, abrojos, hilos, etiquetas...).
model RawMaterial {
  materialRules ProductMaterialRule[]
  movements     RawMaterialMovement[]
  id            String                @id @default(cuid())
  code          String                @unique
  name          String
  type          RawMaterialType
  uom           UnitOfMeasure
  /// Composición o descripción técnica (ej. "50% algodón 50% poliéster")
  composition   String?
  color         String?
  widthCm       Decimal?              @db.Decimal(8, 2)
  /// Rendimiento metros por kg, para convertir compras en kg a consumo en metros
  metersPerKg   Decimal?              @db.Decimal(10, 4)
  /// Costo de reposición vigente por unidad de medida (base del escandallo)
  currentCost   Decimal               @db.Decimal(14, 4)
  stockQty      Decimal               @default(0) @db.Decimal(14, 4)
  minStock      Decimal               @default(0) @db.Decimal(14, 4)
  supplierId    String?
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  bomLines      ProductBOM[]
  priceHistory  RawMaterialPriceHistory[]
  purchaseItems PurchaseItem[]

  @@index([type])
  @@map("raw_materials")
}

model RawMaterialPriceHistory {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  previousCost  Decimal     @db.Decimal(14, 4)
  newCost       Decimal     @db.Decimal(14, 4)
  source        String      @default("MANUAL")
  purchaseId    String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([rawMaterialId, createdAt])
  @@map("raw_material_price_history")
}

/// Comprobante de compra. MERCADERIA: proveedor + ítems con stock. SERVICIO_TALLER: taller + recepciones facturadas.
model Purchase {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  kind           PurchaseKind
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  workshopId     String?
  workshop       Workshop?      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  invoiceType    InvoiceType?
  pointOfSale    Int?
  invoiceNumber  String?
  remitNumber    String?
  status         PurchaseStatus @default(BORRADOR)
  /// Fecha del comprobante (base del Libro IVA Compras)
  date           DateTime       @default(now())
  dueDate        DateTime?
  /// Neto (gravado + no gravado)
  subtotal       Decimal        @db.Decimal(14, 2)
  /// IVA discriminado total
  taxTotal       Decimal        @db.Decimal(14, 2)
  vat21          Decimal        @default(0) @db.Decimal(14, 2)
  vat105         Decimal        @default(0) @db.Decimal(14, 2)
  vat27          Decimal        @default(0) @db.Decimal(14, 2)
  perceptionIva  Decimal        @default(0) @db.Decimal(14, 2)
  perceptionIibb Decimal        @default(0) @db.Decimal(14, 2)
  otherTaxes     Decimal        @default(0) @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  notes          String?
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          PurchaseItem[]
  payables       AccountPayable[]
  invoicedRemits WorkshopRemit[]

  @@index([supplierId, date])
  @@index([workshopId, date])
  @@index([kind, date])
  @@map("purchases")
}

model PurchaseItem {
  id               String           @id @default(cuid())
  purchaseId       String
  purchase         Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemType         PurchaseItemType
  description      String
  rawMaterialId    String?
  rawMaterial      RawMaterial?     @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  productVariantId String?
  productVariant   ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  workshopRemitId  String?
  workshopRemit    WorkshopRemit?   @relation(fields: [workshopRemitId], references: [id], onDelete: Restrict)
  /// Cantidad y unidad tal como figuran en el comprobante (ej. 25 kg)
  quantity         Decimal          @db.Decimal(14, 4)
  uom              UnitOfMeasure
  /// Precio unitario neto del comprobante
  unitCost         Decimal          @db.Decimal(14, 4)
  vatRate          Decimal          @default(21) @db.Decimal(6, 2)
  subtotal         Decimal          @db.Decimal(14, 2)
  /// Cantidad y costo convertidos a la unidad de stock (ej. 65 m a $/m)
  stockQuantity    Decimal?         @db.Decimal(14, 4)
  stockUnitCost    Decimal?         @db.Decimal(14, 4)
  /// Costo de reposición vigente antes de esta compra (auditoría del impacto)
  previousUnitCost Decimal?         @db.Decimal(14, 4)
  updatedCost      Boolean          @default(false)

  @@index([rawMaterialId])
  @@index([productVariantId])
  @@map("purchase_items")
}

// -----------------------------------------------------------------------------
// PRODUCTO, FICHA TÉCNICA (BOM) Y ESCANDALLO
// -----------------------------------------------------------------------------

model Product {
  materialRules ProductMaterialRule[]
  id            String                @id @default(cuid())
  sku           String                @unique
  name          String
  category      ProductCategory
  /// FABRICADO: costo por escandallo. REVENTA: costo = último precio de compra.
  sourcing      ProductSourcing       @default(FABRICADO)
  description   String?
  pricingMode   PricingMode           @default(MARKUP)
  /// Markup sobre costo (MARKUP) o margen sobre precio (MARGIN), en %
  pricingPct    Decimal               @default(100) @db.Decimal(6, 2)
  /// Gastos generales prorrateados sobre el costo directo, en %
  overheadPct   Decimal               @default(0) @db.Decimal(6, 2)
  vatRate       Decimal               @default(21) @db.Decimal(6, 2)
  /// Precio de lista neto vigente (sin IVA)
  listPrice     Decimal               @default(0) @db.Decimal(14, 2)
  /// Costo unitario calculado por el último escandallo (cache desnormalizado)
  currentCost   Decimal               @default(0) @db.Decimal(14, 4)
  costUpdatedAt DateTime?
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  variants         ProductVariant[]
  bom              ProductBOM[]
  services         ProductServiceCost[]
  costSnapshots    ProductCostSnapshot[]
  productionOrders ProductionOrder[]
  saleItems        SaleItem[]
  quoteItems       QuoteItem[]

  @@index([category])
  @@map("products")
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String   @unique
  size               String
  color              String?
  /// Tela o material de la variante (ej. "Algodón peinado", "Piqué")
  fabric             String?
  /// EAN-13. Si no se carga uno, la base asigna uno interno (prefijo 20, uso en el comercio)
  barcode            String?  @unique @default(dbgenerated("next_internal_ean()"))
  stockQty           Decimal  @default(0) @db.Decimal(12, 4)
  /// Ajuste de precio por talle especial (ej. XXXL +10%)
  priceAdjustmentPct Decimal  @default(0) @db.Decimal(6, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  productionItems ProductionOrderItem[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  branchStocks    BranchStock[]
  wooLinks        WooLink[]

  @@unique([productId, size, color, fabric])
  @@map("product_variants")
}

/// Línea de la ficha técnica: consumo de una materia prima por prenda.
model ProductBOM {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  /// Consumo neto por prenda en la UoM de la materia prima (ej. 1.20 m)
  quantity      Decimal     @db.Decimal(12, 4)
  /// Merma / desperdicio de corte en %
  wastePct      Decimal     @default(0) @db.Decimal(6, 2)
  notes         String?
  sortOrder     Int         @default(0)

  @@unique([productId, rawMaterialId])
  @@map("product_bom")
}

/// Tarifario de procesos: corte, fasón de talleres, bordado, estampado, planchado, flete.
model ServiceCost {
  id         String      @id @default(cuid())
  type       ServiceType
  name       String
  workshopId String?
  workshop   Workshop?   @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  /// Tarifa por unidad (prenda, pieza, millar de puntadas, viaje prorrateado...)
  unitCost   Decimal     @db.Decimal(14, 4)
  unitLabel  String      @default("prenda")
  validFrom  DateTime    @default(now())
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  products ProductServiceCost[]

  @@index([type, active])
  @@map("service_costs")
}

/// Proceso aplicado a un producto (escandallo de mano de obra / servicios).
model ProductServiceCost {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceCostId String
  serviceCost   ServiceCost @relation(fields: [serviceCostId], references: [id], onDelete: Restrict)
  quantity      Decimal     @default(1) @db.Decimal(12, 4)
  notes         String?
  sortOrder     Int         @default(0)

  @@unique([productId, serviceCostId])
  @@map("product_service_costs")
}

/// Foto inmutable del escandallo para trazabilidad de costos e historial de precios.
model ProductCostSnapshot {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason         CostSnapshotReason
  materialsCost  Decimal            @db.Decimal(14, 4)
  servicesCost   Decimal            @db.Decimal(14, 4)
  overheadCost   Decimal            @db.Decimal(14, 4)
  totalCost      Decimal            @db.Decimal(14, 4)
  suggestedPrice Decimal            @db.Decimal(14, 2)
  /// Detalle línea por línea (CostBreakdown serializado)
  breakdown      Json
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([productId, createdAt])
  @@map("product_cost_snapshots")
}

// -----------------------------------------------------------------------------
// PRODUCCIÓN Y TALLERES
// -----------------------------------------------------------------------------

model Workshop {
  id              String         @id @default(cuid())
  name            String
  types           WorkshopType[]
  isInternal      Boolean        @default(false)
  cuit            String?        @unique
  /// Define si factura con IVA discriminado (A) o no (C, monotributo)
  taxCondition    TaxCondition   @default(MONOTRIBUTO)
  paymentTermDays Int            @default(30)
  contact         String?
  phone           String?
  address         String?
  notes           String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  serviceCosts  ServiceCost[]
  remits        WorkshopRemit[]
  stageLogs     ProductionStageLog[]
  payables      AccountPayable[]
  purchases     Purchase[]
  paymentOrders PaymentOrder[]

  @@map("workshops")
}

model ProductionOrder {
  id                      String                @id @default(cuid())
  number                  Int                   @unique @default(autoincrement())
  productId               String
  product                 Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  clientId                String?
  client                  Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientDesignId          String?
  clientDesign            ClientDesign?         @relation(fields: [clientDesignId], references: [id], onDelete: SetNull)
  saleId                  String?
  sale                    Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  status                  ProductionOrderStatus @default(BORRADOR)
  currentStage            ProductionStage       @default(CORTE_INTERNO)
  quantityPlanned         Int
  /// Piezas vivas en el proceso: planificadas menos mermas acumuladas
  quantityInProcess       Int                   @default(0)
  quantityFinished        Int                   @default(0)
  /// Si pasa por bordado/estampado/sublimación antes de control de calidad
  requiresPersonalization Boolean               @default(false)
  /// Costo unitario estimado del escandallo al lanzar la orden
  estimatedUnitCost       Decimal               @db.Decimal(14, 4)
  /// Costo real acumulado (materiales consumidos + fasón + fletes)
  actualCost              Decimal               @default(0) @db.Decimal(14, 2)
  dueDate                 DateTime?
  notes                   String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdById             String?
  createdBy               User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  items     ProductionOrderItem[]
  stageLogs ProductionStageLog[]
  remits    WorkshopRemit[]

  @@index([status, currentStage])
  @@map("production_orders")
}

model ProductionOrderItem {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity          Int
  quantityFinished  Int             @default(0)

  @@unique([productionOrderId, variantId])
  @@map("production_order_items")
}

model ProductionStageLog {
  id                String           @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  fromStage         ProductionStage?
  toStage           ProductionStage
  workshopId        String?
  workshop          Workshop?        @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  quantityIn        Int
  quantityOut       Int
  wasteQty          Int              @default(0)
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime         @default(now())

  @@index([productionOrderId, createdAt])
  @@map("production_stage_logs")
}

/// Remito de envío/recepción a talleres externos: piezas enviadas vs. recibidas, merma y fasón.
model WorkshopRemit {
  id                String            @id @default(cuid())
  number            Int               @unique @default(autoincrement())
  type              WorkshopRemitType
  workshopId        String
  workshop          Workshop          @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  productionOrderId String
  productionOrder   ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  stage             ProductionStage
  date              DateTime          @default(now())
  pieces            Int
  wasteQty          Int               @default(0)
  /// Fasón por prenda acordado (en remitos de RECEPCION genera deuda con el taller)
  laborUnitCost     Decimal           @default(0) @db.Decimal(14, 2)
  laborTotal        Decimal           @default(0) @db.Decimal(14, 2)
  notes             String?
  createdById       String?
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Factura del taller que incluyó esta recepción
  purchaseId        String?
  purchase          Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  payables      AccountPayable[]
  purchaseItems PurchaseItem[]

  @@index([productionOrderId])
  @@index([workshopId, date])
  @@map("workshop_remits")
}

// -----------------------------------------------------------------------------
// VENTAS, POS Y CAJAS
// -----------------------------------------------------------------------------

model Sale {
  id                  String               @id @default(cuid())
  number              Int                  @unique @default(autoincrement())
  channel             SaleChannel          @default(MOSTRADOR)
  status              SaleStatus           @default(PENDIENTE)
  clientId            String?
  client              Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashSessionId       String?
  cashSession         CashRegisterSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  branchId            String?
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Vuelto entregado en efectivo
  changeAmount        Decimal              @default(0) @db.Decimal(14, 2)
  // --- Comprobante fiscal (ARCA/AFIP) ---
  invoiceType         InvoiceType          @default(TICKET_INTERNO)
  pointOfSale         Int?
  invoiceNumber       Int?
  cae                 String?
  caeDueDate          DateTime?
  kind                SaleKind             @default(VENTA)
  /// Venta original de una devolución / nota de crédito
  originalSaleId      String?
  originalSale        Sale?                @relation("SaleReturns", fields: [originalSaleId], references: [id], onDelete: Restrict)
  returns             Sale[]               @relation("SaleReturns")
  returnReason        String?
  // --- ARCA ---
  arcaStatus          ArcaStatus           @default(NO_APLICA)
  arcaError           String?
  arcaObservations    Json?
  arcaAttempts        Int                  @default(0)
  /// Número pedido a ARCA en el último intento (para recuperar el CAE si la respuesta se perdió)
  arcaRequestedNumber Int?
  arcaLockedAt        DateTime?
  arcaAuthorizedAt    DateTime?
  // --- Totales ---
  subtotal            Decimal              @db.Decimal(14, 2)
  discountTotal       Decimal              @default(0) @db.Decimal(14, 2)
  discountReason      String?
  taxTotal            Decimal              @db.Decimal(14, 2)
  total               Decimal              @db.Decimal(14, 2)
  // --- Entrega ---
  deliveryMethod      DeliveryMethod       @default(RETIRO_SUCURSAL)
  shippingAddress     String?
  shippingCost        Decimal              @default(0) @db.Decimal(14, 2)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  items            SaleItem[]
  payments         Payment[]
  receivables      AccountReceivable[]
  productionOrders ProductionOrder[]
  cashMovements    CashMovement[]

  @@unique([invoiceType, pointOfSale, invoiceNumber])
  @@index([createdAt])
  @@index([clientId])
  @@index([arcaStatus])
  @@index([originalSaleId])
  @@map("sales")
}

model SaleItem {
  id             String          @id @default(cuid())
  saleId         String
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description    String
  /// Admite venta fraccionada (ej. 1.5 m de tela al público)
  quantity       Decimal         @db.Decimal(12, 4)
  unitPrice      Decimal         @db.Decimal(14, 2)
  discountPct    Decimal         @default(0) @db.Decimal(6, 2)
  discountReason String?
  vatRate        Decimal         @default(21) @db.Decimal(6, 2)
  subtotal       Decimal         @db.Decimal(14, 2)
  /// Costo unitario al momento de la venta (para rentabilidad real)
  unitCost       Decimal         @default(0) @db.Decimal(14, 4)
  /// En devoluciones: ítem de la venta original y si volvió al stock
  originalItemId String?
  originalItem   SaleItem?       @relation("ReturnedItems", fields: [originalItemId], references: [id], onDelete: Restrict)
  returnedItems  SaleItem[]      @relation("ReturnedItems")
  restocked      Boolean         @default(false)

  @@index([productId])
  @@map("sale_items")
}

/// Sucursal / local de venta.
enum BranchKind {
  LOCAL
  MAYORISTA
}

model Branch {
  id          String     @id @default(cuid())
  name        String     @unique
  address     String?
  /// Punto de venta ARCA para los comprobantes del local
  pointOfSale Int?
  /// LOCAL: punto de venta, su stock se publica en la web. MAYORISTA: pedidos personalizados (no se publica).
  kind        BranchKind @default(LOCAL)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cashRegisters CashRegister[]
  sales         Sale[]
  stocks        BranchStock[]
  employees     Employee[]
  users         User[]

  @@map("branches")
}

/// Caja física, billetera virtual o cuenta bancaria.
model CashRegister {
  id                String           @id @default(cuid())
  name              String           @unique
  kind              CashRegisterKind
  /// Las cajas físicas requieren turnos (apertura/cierre ciego); bancos y billeteras no.
  requiresSession   Boolean          @default(true)
  /// Sucursal a la que pertenece (cajas diarias de local)
  branchId          String?
  branch            Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Medios de cobro que se acreditan acá por defecto (ej. banco: transferencias y tarjetas)
  defaultForMethods PaymentMethod[]
  bankName          String?
  cbu               String?
  alias             String?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  paymentOrders     PaymentOrder[]
  paymentOrderItems PaymentOrderItem[]
  chequesHeld       Cheque[]
  sessions          CashRegisterSession[]
  movements         CashMovement[]
  payments          Payment[]

  @@map("cash_registers")
}

/// Turno de caja. Regla de negocio (servicio): una sola sesión ABIERTA por caja.
model CashRegisterSession {
  id              String            @id @default(cuid())
  cashRegisterId  String
  cashRegister    CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  status          CashSessionStatus @default(ABIERTA)
  openedById      String
  openedBy        User              @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt        DateTime          @default(now())
  /// Efectivo contado al abrir
  openingAmount   Decimal           @db.Decimal(14, 2)
  /// Saldo que el sistema esperaba al abrir (cierre anterior menos retiros)
  openingExpected Decimal           @default(0) @db.Decimal(14, 2)
  closedById      String?
  closedBy        User?             @relation("SessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt        DateTime?
  /// Calculado por el sistema al cierre (apertura + ingresos - egresos en efectivo)
  expectedAmount  Decimal?          @db.Decimal(14, 2)
  /// Declarado por el cajero a ciegas (sin ver el esperado)
  declaredAmount  Decimal?          @db.Decimal(14, 2)
  /// declarado - esperado: >0 sobrante, <0 faltante
  difference      Decimal?          @db.Decimal(14, 2)
  notes           String?

  movements CashMovement[]
  sales     Sale[]
  receipts  Receipt[]

  @@index([cashRegisterId, status])
  @@map("cash_register_sessions")
}

model CashMovement {
  id              String               @id @default(cuid())
  cashRegisterId  String
  cashRegister    CashRegister         @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  sessionId       String?
  session         CashRegisterSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type            CashMovementType
  method          PaymentMethod
  /// Siempre positivo; el signo lo determina `type`
  amount          Decimal              @db.Decimal(14, 2)
  concept         String
  saleId          String?
  sale            Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  /// Vincula ambas patas de una transferencia entre cajas
  transferGroupId String?
  paymentOrderId  String?
  paymentOrder    PaymentOrder?        @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  receiptId       String?
  receipt         Receipt?             @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  chequeId        String?
  cheque          Cheque?              @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())

  payment Payment?

  @@index([cashRegisterId, createdAt])
  @@index([sessionId])
  @@map("cash_movements")
}

/// Orden de pago a proveedor o taller. Imputa a uno o varios comprobantes (un Payment por cada uno).
model PaymentOrder {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  workshopId     String?
  workshop       Workshop?      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  /// Pago de sueldo a personal propio (no es proveedor ni taller)
  employeeId     String?
  employee       Employee?      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Mes al que corresponde el pago de sueldo (AAAA-MM)
  salaryPeriod   String?
  salaryConcept  SalaryConcept?
  date           DateTime       @default(now())
  /// Medio único (órdenes anteriores). Las nuevas detallan sus instrumentos en items.
  method         PaymentMethod?
  cashRegisterId String?
  cashRegister   CashRegister?  @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  amount         Decimal        @db.Decimal(14, 2)
  reference      String?
  notes          String?
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())

  payments      Payment[]
  items         PaymentOrderItem[]
  cheques       Cheque[]
  cashMovements CashMovement[]

  @@index([supplierId, date])
  @@index([workshopId, date])
  @@index([employeeId, salaryPeriod])
  @@map("payment_orders")
}

/// Instrumento con el que se paga una orden de pago: efectivo/transferencia desde una caja o cuenta, o un cheque.
model PaymentOrderItem {
  id             String        @id @default(cuid())
  paymentOrderId String
  paymentOrder   PaymentOrder  @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 2)
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  chequeId       String?
  cheque         Cheque?       @relation(fields: [chequeId], references: [id], onDelete: Restrict)
  reference      String?

  @@index([paymentOrderId])
  @@map("payment_order_items")
}

/// Cheque o eCheq. TERCERO: recibido de un cliente (cartera). PROPIO: emitido por Coverline.
model Cheque {
  id              String        @id @default(cuid())
  kind            ChequeKind
  format          ChequeFormat  @default(FISICO)
  status          ChequeStatus
  bank            String
  number          String
  /// Librador (quien lo firma)
  issuerName      String
  issuerCuit      String?
  amount          Decimal       @db.Decimal(14, 2)
  issueDate       DateTime
  /// Fecha de cobro (diferido)
  paymentDate     DateTime
  /// Cliente que lo entregó (terceros)
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Cuenta bancaria propia (propios) o cuenta donde se depositó / caja donde se cobró (terceros)
  cashRegisterId  String?
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  /// Orden de pago con la que se endosó (terceros) o entregó (propios)
  paymentOrderId  String?
  paymentOrder    PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  deliveredTo     String?
  depositedAt     DateTime?
  clearedAt       DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment           Payment?
  paymentOrderItems PaymentOrderItem[]
  movements         CashMovement[]
  receivables       AccountReceivable[]

  @@index([kind, status, paymentDate])
  @@index([clientId])
  @@map("cheques")
}

/// Recibo de cobranza de cuenta corriente de un cliente.
model Receipt {
  id          String               @id @default(cuid())
  number      Int                  @unique @default(autoincrement())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  date        DateTime             @default(now())
  amount      Decimal              @db.Decimal(14, 2)
  sessionId   String?
  session     CashRegisterSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  notes       String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())

  payments      Payment[]
  allocations   ReceiptAllocation[]
  cashMovements CashMovement[]

  @@index([clientId, date])
  @@map("receipts")
}

/// Imputación de un recibo a una deuda del cliente.
model ReceiptAllocation {
  id                  String            @id @default(cuid())
  receiptId           String
  receipt             Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  accountReceivableId String
  accountReceivable   AccountReceivable @relation(fields: [accountReceivableId], references: [id], onDelete: Restrict)
  amount              Decimal           @db.Decimal(14, 2)

  @@index([accountReceivableId])
  @@map("receipt_allocations")
}

model Payment {
  id                  String             @id @default(cuid())
  method              PaymentMethod
  amount              Decimal            @db.Decimal(14, 2)
  /// Nro. de operación, últimos 4 de tarjeta, id de Mercado Pago, etc.
  reference           String?
  receiptUrl          String?
  cardBrand           String?
  installments        Int?
  surchargePct        Decimal            @default(0) @db.Decimal(6, 2)
  saleId              String?
  sale                Sale?              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Cobranza de cuenta corriente (recibo)
  receiptId           String?
  receipt             Receipt?           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  /// Cheque / eCheq recibido con este cobro
  chequeId            String?            @unique
  cheque              Cheque?            @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  accountReceivableId String?
  accountReceivable   AccountReceivable? @relation(fields: [accountReceivableId], references: [id], onDelete: SetNull)
  paymentOrderId      String?
  paymentOrder        PaymentOrder?      @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  accountPayableId    String?
  accountPayable      AccountPayable?    @relation(fields: [accountPayableId], references: [id], onDelete: SetNull)
  cashRegisterId      String?
  cashRegister        CashRegister?      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  cashMovementId      String?            @unique
  cashMovement        CashMovement?      @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())

  @@index([saleId])
  @@index([createdAt, method])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// CUENTAS CORRIENTES
// -----------------------------------------------------------------------------

/// Documento deudor del cliente (venta en cta. cte., nota de débito, saldo inicial).
model AccountReceivable {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  saleId      String?
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  description String
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  amount      Decimal       @db.Decimal(14, 2)
  balance     Decimal       @db.Decimal(14, 2)
  status      AccountStatus @default(PENDIENTE)
  /// Deuda generada por un cheque rechazado
  chequeId    String?
  cheque      Cheque?       @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments    Payment[]
  allocations ReceiptAllocation[]

  @@index([clientId, status, dueDate])
  @@map("accounts_receivable")
}

/// Deuda con proveedor de materia prima o con taller (fasón).
model AccountPayable {
  id              String         @id @default(cuid())
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  workshopId      String?
  workshop        Workshop?      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  purchaseId      String?
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  workshopRemitId String?
  workshopRemit   WorkshopRemit? @relation(fields: [workshopRemitId], references: [id], onDelete: SetNull)
  description     String
  issueDate       DateTime       @default(now())
  dueDate         DateTime
  amount          Decimal        @db.Decimal(14, 2)
  balance         Decimal        @db.Decimal(14, 2)
  status          AccountStatus  @default(PENDIENTE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments Payment[]

  @@index([supplierId, status, dueDate])
  @@index([workshopId, status, dueDate])
  @@map("accounts_payable")
}

/// Stock de cada variante en cada local. ProductVariant.stockQty es la suma (total).
model BranchStock {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  quantity  Decimal        @default(0) @db.Decimal(12, 4)
  updatedAt DateTime       @updatedAt

  @@unique([variantId, branchId])
  @@index([branchId])
  @@map("branch_stocks")
}

// ─── Tienda web (WooCommerce) ─────────────────────────────────────────────

/// Producto o variación de WooCommerce y la variante del ERP con la que se sincroniza.
model WooLink {
  id             String          @id @default(cuid())
  wooProductId   Int
  /// 0 = producto simple (sin variaciones)
  wooVariationId Int             @default(0)
  wooSku         String?
  wooName        String
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Cómo se vinculó: SKU (automático) o MANUAL
  linkedBy       String?
  lastPushedQty  Int?
  lastPushedAt   DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([wooProductId, wooVariationId])
  @@index([variantId])
  @@map("woo_links")
}

/// Pedidos de la tienda ya descontados del stock (para no descontarlos dos veces).
model WooOrder {
  id         String   @id @default(cuid())
  wooOrderId Int      @unique
  number     String
  status     String
  /// true mientras el stock del pedido está descontado
  deducted   Boolean  @default(false)
  /// Pedido ya completado al activar la sincronización: se registra pero nunca mueve stock
  baseline   Boolean  @default(false)
  branchId   String?
  /// [{ variantId, sku, name, quantity }]
  lines      Json
  total      Decimal  @default(0) @db.Decimal(14, 2)
  customer   String?
  orderDate  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("woo_orders")
}

/// Registro de cada sincronización con la tienda.
model WooSyncRun {
  id         String    @id @default(cuid())
  trigger    String
  mode       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json?
  error      String?

  @@index([startedAt])
  @@map("woo_sync_runs")
}

/// Conexión con la tienda por el plugin de WordPress (el plugin llama al ERP;
/// sirve cuando el hosting bloquea las conexiones entrantes).
model WooBridge {
  id               String    @id @default("default")
  /// Clave que el plugin manda en cada llamada
  token            String
  lastSeenAt       DateTime?
  pluginVersion    String?
  siteUrl          String?
  /// Pedirle al plugin la lista de productos en la próxima llamada
  catalogRequested Boolean   @default(true)
  lastCatalogAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("woo_bridge")
}

enum SalaryConcept {
  SUELDO
  ADELANTO
  AGUINALDO
  VACACIONES
  PREMIO
  HORAS_EXTRA
  OTRO
}

/// Personal de Coverline (atención al público, logística, ventas mayoristas…). Los talleres van aparte.
model Employee {
  id          String    @id @default(cuid())
  name        String
  cuil        String?   @unique
  /// Puesto: texto libre (se sugieren los ya usados)
  position    String
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  startDate   DateTime?
  /// Sueldo mensual acordado (neto a pagar)
  baseSalary  Decimal   @default(0) @db.Decimal(14, 2)
  phone       String?
  email       String?
  /// CBU o alias para transferirle
  bankAccount String?
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  paymentOrders PaymentOrder[]

  @@map("employees")
}

/// Configuración general y marcas internas (ej. qué partes del seed ya se cargaron).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/**
 * Reglas de consumo de un material de la ficha técnica (independientes de los
 * renglones de la ficha, que se recrean al guardarla):
 * - consumo distinto por talle (el de la ficha es el del talle de referencia);
 * - material alternativo según el color o la tela de la variante (ej. tela bordó en vez de azul).
 */
model ProductMaterialRule {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Material de referencia de la ficha (el que se costea)
  rawMaterialId  String
  rawMaterial    RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  /// { "XL": 1.6, "4": 0.9 }: consumo neto por prenda para esos talles
  sizeQuantities Json?
  /// [{ color, fabric, rawMaterialId }]: material que reemplaza al de referencia en esas variantes
  alternatives   Json?
  updatedAt      DateTime    @updatedAt

  @@unique([productId, rawMaterialId])
  @@map("product_material_rules")
}

/// Movimiento de stock de una materia prima (kardex): compras, consumo de producción, devoluciones y ajustes.
model RawMaterialMovement {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  /// Positivo entra, negativo sale (en la unidad de medida del material)
  delta         Decimal     @db.Decimal(14, 4)
  /// COMPRA, ANULACION_COMPRA, CONSUMO_OP, DEVOLUCION_OP, AJUSTE_CORTE, AJUSTE, IMPORTACION
  reason        String
  /// Origen: "OP" (orden de producción), "COMPRA", etc.
  refType       String?
  refId         String?
  /// Costo unitario al momento del movimiento (para valuar y revertir)
  unitCost      Decimal?    @db.Decimal(14, 4)
  notes         String?
  userId        String?
  createdAt     DateTime    @default(now())

  @@index([rawMaterialId, createdAt])
  @@index([refType, refId])
  @@map("raw_material_movements")
}
