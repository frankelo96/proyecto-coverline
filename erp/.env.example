# PostgreSQL
DATABASE_URL="postgresql://coverline:coverline@localhost:5432/coverline?schema=public"

# Facturación electrónica ARCA (WSFEv1). Modos: deshabilitado | homologacion | produccion
ARCA_MODE="deshabilitado"
ARCA_CUIT=""
# Certificado y clave privada del CUIT emisor: ruta a archivo o el PEM completo
ARCA_CERT=""
ARCA_KEY=""
# Opcional: URLs alternativas (proxy o entorno de pruebas)
ARCA_WSAA_URL=""
ARCA_WSFE_URL=""

# Datos de la empresa impresos en facturas, presupuestos, remitos y demás documentos
# (si se dejan vacíos se usan los de Uniformes de la Recta SRL)
COMPANY_LEGAL_NAME=""
COMPANY_TRADE_NAME=""
COMPANY_CUIT=""
COMPANY_IIBB=""
COMPANY_START_DATE=""
COMPANY_ADDRESS=""
COMPANY_PHONE=""
COMPANY_EMAIL=""
COMPANY_WEB=""

# Opcional: número con el que sigue la numeración de presupuestos (ej. 377 para continuar la actual)
QUOTE_NEXT_NUMBER=""

# Local que recibe compras y producción terminada (por defecto el de punto de venta más bajo)
STOCK_MAIN_BRANCH=""

# Tienda WooCommerce: sincronización de stock (ver README → Tienda web)
WOO_URL=""
WOO_CONSUMER_KEY=""
WOO_CONSUMER_SECRET=""
# desactivado | solo-lectura | activo
WOO_SYNC_MODE="solo-lectura"
WOO_SAFETY_STOCK="2"
WOO_SYNC_MINUTES="5"
WOO_ORDERS_BRANCH=""
WOO_CRON_TOKEN=""
